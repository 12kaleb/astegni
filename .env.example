# App database connection. Use the Supabase pooled connection string in production.
DATABASE_URL="postgresql://postgres:password@localhost:5432/astegni?schema=public"

# Direct connection for Prisma migrations. Local development may use DATABASE_URL here.
DIRECT_URL="postgresql://postgres:password@localhost:5432/astegni?schema=public"

# Supabase project settings (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"

# Server-only key for private verification uploads and public avatar storage.
# Use a Supabase secret key (sb_secret_...) or legacy service_role key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# Public canonical origin used in page metadata and sitemap.xml.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Trust x-forwarded-for / x-real-ip only when a trusted reverse proxy overwrites them.
# Vercel is trusted automatically; non-Vercel production requires this for startup.
TRUST_PROXY_HEADERS="false"

# Optional Sentry project DSN. Configure the same project in your deployment environment.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Optional: set in CI/deployment secrets only when uploading source maps.
SENTRY_AUTH_TOKEN=""

# Optional transactional email delivery through Resend.
RESEND_API_KEY=""
EMAIL_FROM="Astegni <bookings@your-domain.example>"

# Jitsi public host (domain only; defaults to meet.jit.si).
JITSI_DOMAIN="meet.jit.si"

# Local ETB checkout through Chapa.
CHAPA_SECRET_KEY=""
CHAPA_WEBHOOK_SECRET=""

# International USD checkout through Stripe.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Call GET /api/cron/lesson-reminders hourly with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""
LESSON_REMINDER_WINDOW_MINUTES="60"
